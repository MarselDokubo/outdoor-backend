generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  user
  creator
  moderator
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  deactivated
}

model User {
  id          String  @id @default(cuid())
  email       String? @unique
  displayName String?

  status     UserStatus @default(active)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authIdentities  AuthIdentity[]
  roleAssignments UserRoleAssignment[]
  reactions       Reaction[]
  saves           Save[]
  comments        Comment[]

  @@index([status])
}

model AuthIdentity {
  id              String    @id @default(cuid())
  userId          String
  provider        String
  providerSubject String
  providerEmail   String?
  emailVerified   Boolean?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model UserRoleAssignment {
  id         String     @id @default(cuid())
  userId     String
  role       SystemRole
  assignedBy String?
  assignedAt DateTime   @default(now())
  reason     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

enum PlacePublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlaceVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PlaceSourceType {
  USER_SUBMITTED
  CURATED
  IMPORTED
}

enum PlaceClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PlaceOwnerRole {
  OWNER
  MANAGER
}

enum PlaceOwnerMembershipStatus {
  ACTIVE
  REVOKED
}

model Place {
  id                String                 @id
  slug              String                 @unique
  name              String
  categoryCode      String
  shortDescription  String?
  fullDescription   String?
  phone             String?
  email             String?
  website           String?
  latitude          Float
  longitude         Float
  addressLine1      String?
  addressLine2      String?
  area              String?
  city              String?
  state             String?
  postalCode        String?
  countryCode       String
  formattedAddress  String?
  publicationStatus PlacePublicationStatus @default(DRAFT)
  visibility        PlaceVisibility        @default(PRIVATE)
  sourceType        PlaceSourceType        @default(USER_SUBMITTED)
  officialTagline   String?
  officialSummary   String?
  isOwnerManaged    Boolean                @default(false)
  isVerified        Boolean                @default(false)
  createdByUserId   String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?

  claims           PlaceClaim[]
  ownerMemberships PlaceOwnerMembership[]

  @@index([publicationStatus, visibility])
  @@index([categoryCode])
  @@index([latitude, longitude])
  @@index([name])
  @@index([city])
  @@index([area])
}

model PlaceClaim {
  id               String           @id
  placeId          String
  claimantUserId   String
  proofReferences  Json
  status           PlaceClaimStatus @default(PENDING)
  submittedAt      DateTime         @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNotes      String?
  updatedAt        DateTime         @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, status])
  @@index([claimantUserId, status])
  @@index([submittedAt])
}

model PlaceOwnerMembership {
  id              String                     @id
  placeId         String
  userId          String
  role            PlaceOwnerRole
  status          PlaceOwnerMembershipStatus @default(ACTIVE)
  grantedAt       DateTime                   @default(now())
  grantedByUserId String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([userId, status])
  @@index([placeId, status])
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaProcessingStatus {
  UPLOADED
  READY
  FAILED
  DELETED
}

enum MediaAttachmentOwnerType {
  PLACE
  POST
  EVENT
}

enum MediaAttachmentRole {
  PRIMARY
  GALLERY
  CONTENT
}

model MediaAsset {
  id               String                @id
  uploaderUserId   String
  kind             MediaKind
  mimeType         String
  originalFilename String
  storageKey       String                @unique
  sizeBytes        Int
  checksumSha256   String
  width            Int?
  height           Int?
  durationSeconds  Int?
  processingStatus MediaProcessingStatus
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  attachments MediaAttachment[]

  @@index([uploaderUserId])
  @@index([processingStatus])
  @@index([deletedAt])
}

model MediaAttachment {
  id               String                   @id
  mediaAssetId     String
  ownerType        MediaAttachmentOwnerType
  ownerId          String
  role             MediaAttachmentRole
  sortOrder        Int                      @default(0)
  attachedByUserId String
  createdAt        DateTime                 @default(now())
  detachedAt       DateTime?

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId, detachedAt])
  @@index([mediaAssetId, detachedAt])
  @@index([attachedByUserId])
}

enum VisitStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VisitSourceType {
  MANUAL_CHECK_IN
  SYSTEM_DETECTED
}

model Visit {
  id              String          @id @db.VarChar(50)
  userId          String          @db.VarChar(50)
  placeId         String          @db.VarChar(50)
  status          VisitStatus
  sourceType      VisitSourceType
  startedAt       DateTime
  endedAt         DateTime?
  confidenceScore Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, status])
  @@index([placeId, status])
  @@index([placeId, startedAt])
  @@index([userId, startedAt])
}

// Merge this into prisma/schema.prisma

enum PostPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Post {
  id                String                @id
  authorUserId      String
  placeId           String
  body              String                @db.Text
  publicationStatus PostPublicationStatus
  visibility        PostVisibility
  createdAt         DateTime              @default(now())
  updatedAt         DateTime
  publishedAt       DateTime?
  archivedAt        DateTime?

  @@index([placeId, publicationStatus, visibility, createdAt(sort: Desc)])
  @@index([authorUserId, createdAt(sort: Desc)])
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

model Event {
  id          String          @id
  hostUserId  String
  placeId     String?
  title       String
  summary     String?
  description String?
  startsAt    DateTime
  endsAt      DateTime
  visibility  EventVisibility @default(PUBLIC)
  status      EventStatus     @default(DRAFT)
  publishedAt DateTime?
  cancelledAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime

  @@index([placeId, status, visibility, startsAt])
  @@index([hostUserId, createdAt])
}

enum EngagementTargetType {
  PLACE
  POST
  EVENT
}

enum ReactionType {
  LIKE
  INTERESTED
  FIRE
}

model Reaction {
  id           String               @id @default(cuid())
  userId       String
  targetType   EngagementTargetType
  targetId     String
  reactionType ReactionType
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId], map: "reaction_user_target_unique")
  @@index([targetType, targetId], map: "reaction_target_idx")
  @@index([userId, createdAt], map: "reaction_user_created_idx")
}

model Save {
  id         String               @id @default(cuid())
  userId     String
  targetType EngagementTargetType
  targetId   String
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId], map: "save_user_target_unique")
  @@index([targetType, targetId], map: "save_target_idx")
  @@index([userId, createdAt], map: "save_user_created_idx")
}

enum CommentStatus {
  ACTIVE
  DELETED
}

model Comment {
  id           String               @id
  authorUserId String
  targetType   EngagementTargetType
  targetId     String
  body         String               @db.Text
  status       CommentStatus        @default(ACTIVE)
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  author User @relation(fields: [authorUserId], references: [id])

  @@index([targetType, targetId, createdAt(sort: Asc)])
  @@index([targetType, targetId, status, createdAt(sort: Asc)])
  @@index([authorUserId, createdAt(sort: Desc)])
}
